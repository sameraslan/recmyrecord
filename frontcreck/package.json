{
  "name": "frontcreck",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "perf": "node scripts/perf/perf.mjs",
    "shots": "node scripts/review-shots.mjs",
    "theme": "node scripts/theme/build-theme.mjs",
    "theme:module": "node scripts/theme/build-module.mjs"
  },
  "dependencies": {
    "@react-three/fiber": "9.8.1",
    "fuse.js": "7.5.0",
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "three": "0.186.1",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "22.20.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.8",
    "jsdom": "29.1.1",
    "postcss": "8.5.28",
    "sharp": "0.35.5",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  },
  "overrides": {
    "playwright-core": "$@playwright/test"
  }
}
