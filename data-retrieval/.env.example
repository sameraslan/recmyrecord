# Environment variables used by the legacy scripts in data-retrieval/.
# Copy to .env (ignored by git) or export in your shell. Never commit real values.

# Spotify API (read automatically by spotipy's SpotifyClientCredentials)
SPOTIPY_CLIENT_ID=
SPOTIPY_CLIENT_SECRET=

# Postgres for Recommender/populate_db.py: either a single URL...
DATABASE_URL=
# ...or the individual libpq-style settings
PGHOST=
PGPORT=5432
PGUSER=
PGPASSWORD=
PGDATABASE=
